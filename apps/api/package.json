{
  "name": "@opulent/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts | pino-pretty --colorize --singleLine --translateTime SYS:HH:MM:ss --ignore pid,hostname,method,path,status,duration,code,message --messageFormat '{if method}{method} {path}{end}{if status} {status}{end}{if code} {code}{end}{if duration} {duration}ms{end}{if msg} {msg}{end}{if message} - {message}{end}'",
    "smoke": "tsx src/smoke-test.ts",
    "build": "esbuild src/lambda.ts --bundle --platform=node --target=node26 --format=esm --outfile=dist/lambda.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@hono/zod-validator": "catalog:",
    "@opulent/db": "workspace:*",
    "@opulent/shared": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "jose": "catalog:",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "pino-pretty": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
