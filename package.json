{
  "name": "opulent-tutor",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Trade binders for Magic: The Gathering players and collectors",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": ">=10.26.1 <11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "check:ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm check:packages && pnpm knip && pnpm infra:synth && pnpm --filter @opulent/infra run check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "node --max-old-space-size=4096 node_modules/eslint/bin/eslint.js . --cache --max-warnings=0",
    "lint:fix": "node --max-old-space-size=4096 node_modules/eslint/bin/eslint.js . --fix --cache",
    "typecheck": "tsc -p tsconfig.json --noEmit && turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "smoke": "pnpm --filter @opulent/api run smoke",
    "db:bootstrap": "pnpm --filter @opulent/db run bootstrap",
    "db:generate": "pnpm --filter @opulent/db run generate",
    "db:migrate": "pnpm --filter @opulent/db run migrate",
    "db:push": "pnpm --filter @opulent/db run push",
    "db:studio": "pnpm --filter @opulent/db run studio",
    "db:seed": "pnpm --filter @opulent/db run seed",
    "db:reset": "pnpm --filter @opulent/db run reset",
    "db:drift": "pnpm db:generate && git diff --exit-code -- packages/db/migrations",
    "places:sync": "pnpm --filter @opulent/db run places:sync",
    "cards:sync": "pnpm --filter @opulent/card-sync run start",
    "check:packages": "manypkg check",
    "knip": "knip",
    "infra:synth": "turbo run synth --filter=@opulent/infra",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@eslint/js": "catalog:",
    "@manypkg/cli": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-boundaries": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "eslint-plugin-turbo": "catalog:",
    "globals": "catalog:",
    "husky": "catalog:",
    "jsdom": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
