# Copy to .env and fill in. Never commit .env.

# --- Database ---
# Local dev points at the docker-compose Postgres below.
DATABASE_URL=postgres://opulent:opulent@localhost:5432/opulent_tutor

# --- Auth0 ---
# Found in the Auth0 dashboard under Applications and APIs.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.opulenttutor.com

# --- API ---
PORT=8787
CORS_ORIGIN=http://localhost:5173

# --- Web (Vite needs the VITE_ prefix to expose these to the browser) ---
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_AUDIENCE=https://api.opulenttutor.com
VITE_API_BASE_URL=http://localhost:8787

# --- Card sync job ---
# Scryfall requires an accurate User-Agent on every request.
SCRYFALL_USER_AGENT=OpulentTutor/0.1 (+https://opulenttutor.com)
SCRYFALL_BULK_TYPE=all_cards
