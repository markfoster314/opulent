# Copy to .env and fill in. Never commit .env.

# --- Database ---
# Local dev points at the docker-compose Postgres below.
DATABASE_URL=postgres://opulent:opulent@localhost:5432/opulent_tutor
# Optional. Set to true to print SQL.
# DB_LOG=true
# Leave unset. Set to 1 only to run db:seed, db:reset, or db:push against a remote host.
# ALLOW_REMOTE_DB=1

# --- Auth0 ---
# Found in the Auth0 dashboard under Applications and APIs.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.opulenttutor.com

# --- API ---
PORT=8787
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Optional. Local default is debug. Production default is info.
# LOG_LEVEL=debug
# Trade email stays off until both of these are set. WEB_ORIGIN is the site used in those links.
# RESEND_API_KEY=
# EMAIL_FROM=
# WEB_ORIGIN=

# --- Web (Vite needs the VITE_ prefix to expose these to the browser) ---
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_AUDIENCE=https://api.opulenttutor.com
VITE_API_BASE_URL=http://localhost:8787

# --- Card sync job ---
# Scryfall requires an accurate User-Agent on every request.
SCRYFALL_USER_AGENT=OpulentTutor/0.1 (+https://opulenttutor.com)
SCRYFALL_BULK_TYPE=all_cards
# Optional cap for a local card sync. The deployed job does not set this.
# SCRYFALL_MAX_ROWS=
