{
  "name": "@opulent/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./env": "./src/load-env.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "push": "tsx src/assert-local-db.ts && drizzle-kit push",
    "studio": "drizzle-kit studio",
    "bootstrap": "tsx src/bootstrap.ts",
    "places:sync": "tsx src/import-places.ts",
    "seed": "tsx src/seed.ts",
    "reset": "tsx src/reset.ts"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "catalog:",
    "@opulent/shared": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "fflate": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "drizzle-kit": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
